# Postgres connection string
DATABASE_URL=postgres://shab:shab@localhost:5432/shabcrm
# Random 32+ character secret for signing sessions: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me
# Public URL of the app
BETTER_AUTH_URL=http://localhost:3000

# Texting and calls (Twilio). Leave blank for test mode: messages are saved but not sent.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Email (Postmark). Leave blank for test mode.
POSTMARK_SERVER_TOKEN=
# Your Postmark inbound address, e.g. abc123@inbound.postmarkapp.com
POSTMARK_INBOUND_ADDRESS=
# Any long random string; it goes on the end of the inbound webhook URL shown in Settings
POSTMARK_INBOUND_SECRET=

# Calendars. Apple iCloud, other CalDAV calendars and calendar links work without these.
# Google: see "Connect Google Calendar" in the README. Redirect URI: <BETTER_AUTH_URL>/api/calendars/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Microsoft/Outlook: see the README. Redirect URI: <BETTER_AUTH_URL>/api/calendars/callback/microsoft
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Workflow automations run in the background inside the app. Set to "off" to
# stop this copy of the app from running them (e.g. on a second server).
# WORKFLOW_WORKER=off
